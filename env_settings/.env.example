# Шаблон окружения.
# Скопируйте файл в env_settings/.env.stage и заполните значения:
#   Windows: copy env_settings\.env.example env_settings\.env.stage
#   *nix:    cp env_settings/.env.example env_settings/.env.stage
#
# Реальный .env.stage в git не хранится (см. .gitignore).
# В CI секреты задаются переменными окружения GitLab
# (Settings → CI/CD → Variables), например masked-переменной API_KEY.

# ── Окружения ───────────────────────────────────────────────
BASE_URL=https://eq-legal-collection-stage.bdengi.ru
EQ_LEGAL_COLLECTION_BASE_URL=https://eq-legal-collection-stage.bdengi.ru
STAGING_BASE_URL=https://eq-debt-collection-stage.bdengi.ru
EQ_DEBT_COLLECTION_BASE_URL=https://eq-debt-collection-stage.bdengi.ru
PRODUCTION_BASE_URL=https://lc.production.mmk.local
NODE_ENV=development
TEST_ENV=stage

# ── Браузер ─────────────────────────────────────────────────
HEADLESS=true
SLOW_MO=0

# ── Доступы к API ───────────────────────────────────────────
# API-ключ сервиса eq-legal-collection: передаётся в заголовке x-api-key
# (см. документацию сервиса — /v3/api-docs). Без него тесты падают с ошибкой.
API_KEY=
# Токен остальных сервисов: отправляется как Authorization: Bearer <AUTH_TOKEN>
AUTH_TOKEN=
# Базовый адрес и секреты eq-dc-court
EQ_DC_COURT_BASE_URL=
EQ_DC_COURT_API_KEY=
EQ_DC_COURT_TOKEN=
# Тестовые данные eq-dc-court (можно оставить значения по умолчанию из spec-файлов)
EQ_DC_COURT_TEST_INN=
EQ_DC_COURT_TEST_FIO=
EQ_DC_COURT_TEST_BIRTH_DATE=
EQ_DC_COURT_TEST_ADDRESS=
# Базовый адрес сервиса eq-dc-debt-importer (используется в его спеках)
API_URL=http://eq-dc-debt-importer.test2.mmk.local
EQ_DC_DEBT_IMPORTER_BASE_URL=http://eq-dc-debt-importer.test2.mmk.local
EQ_DC_DEBT_IMPORTER_TOKEN=
CONTRACTOR_ID=
CONTRACT_IMPORT_ID=
CONTRACT_ID=
PACKAGE_ID=
# true — подробный лог запросов/ответов в ApiClient (секреты маскируются)
API_DEBUG=false

# ── Почтовые отчёты (опционально) ───────────────────────────
OUTLOOK_EMAIL=your-email@outlook.com
OUTLOOK_PASSWORD=your-password-or-app-password
EMAIL_USER=your-email@outlook.com
EMAIL_PASS=your-password